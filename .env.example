# ──────────────────────────────────────────────────────────────────
#  .env.example — E-Administrasi Prodi
#  Salin ke .env lalu isi nilai yang kosong sebelum menjalankan
#  docker compose up
# ──────────────────────────────────────────────────────────────────

# ── Aplikasi ───────────────────────────────────────────────────────
APP_NAME="E-Administrasi Prodi"
APP_ENV=production
APP_KEY=                        # generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com  # ganti dengan domain VPS Anda
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# ── Log ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning               # production: warning / error

# ── Database (MySQL container) ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                      # nama service di docker-compose
DB_PORT=3306
DB_DATABASE=eadmin
DB_USERNAME=eadmin
DB_PASSWORD=                    # WAJIB DIISI — password kuat
DB_ROOT_PASSWORD=               # WAJIB DIISI — root password MySQL

# ── Session & Cache (Redis container) ─────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=yourdomain.com   # ganti domain

CACHE_STORE=redis

REDIS_HOST=redis                # nama service di docker-compose
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Queue ──────────────────────────────────────────────────────────
QUEUE_CONNECTION=database       # atau redis jika ingin lebih cepat

# ── Filesystem ────────────────────────────────────────────────────
FILESYSTEM_DISK=local           # jangan ubah — file disimpan di storage/app/private

# ── Mail (opsional — notifikasi email) ───────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcast (tidak dipakai di MVP) ─────────────────────────────
BROADCAST_CONNECTION=log

# ── Vite ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
