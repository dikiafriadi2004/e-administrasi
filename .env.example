# ──────────────────────────────────────────────────────────────────
#  .env.example — E-Administrasi Prodi
#  Salin ke .env lalu isi nilai yang kosong sebelum menjalankan
# ──────────────────────────────────────────────────────────────────

# ── Aplikasi ───────────────────────────────────────────────────────
APP_NAME="SISTEM ADMINISTRASI DIGITAL ILMU KOMUNIKASI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# ── Log ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (MySQL container) ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eadmin
DB_USERNAME=eadmin
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Session & Cache ────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=yourdomain.com

CACHE_STORE=redis

# ── Trusted Proxies ────────────────────────────────────────────────
# Kosongkan jika nginx terminasi langsung (topologi Docker saat ini).
# Set "*" atau daftar IP proxy yang dipisah koma jika ada CDN/LB di depan,
# agar rate limiter & request()->ip() melihat IP klien asli.
TRUSTED_PROXIES=

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Queue ──────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Trusted Proxies (isi jika di belakang CDN/Load Balancer) ─────────────────
# Kosongkan untuk server langsung. Isi '*' untuk trust semua proxy, atau IP spesifik: '10.0.0.1,10.0.0.2'
TRUSTED_PROXIES=


BROADCAST_CONNECTION=log

# ── Vite ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
